{
  "name": "wapad",
  "compatibility_date": "2026-08-18",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "exclude": [
      ".git/**",
      ".github/**",
      "README.md",
      "LAUNCH_CHECKLIST.md",
      "SOURCES_AND_LICENCES.csv",
      "assessment-fragment.html",
      "assets/site-00.css",
      "assets/site-01.css",
      "assets/site-02.css",
      "assets/site-03.css",
      "assets/site-04.css",
      "assets/site-05.css",
      "assets/site.js",
      "assets/complete.js"
    ]
  }
}
